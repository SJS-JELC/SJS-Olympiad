{
  "name": "sjs-olympiad-security-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "local-preview": "node scripts/local-preview.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node api/src/presentation/validate.mjs && npm run check:engines && npm run check:typography && npm run typecheck && vite build && npm run check:private && node scripts/check-protected-presentations.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:contracts": "node --test --test-isolation=none --require ./tests/node/register-typescript.cjs tests/node/*.test.cjs",
    "test:browser": "playwright test",
    "check:engines": "node scripts/sync-chemistry-engines.mjs --check",
    "sync:engines": "node scripts/sync-chemistry-engines.mjs --write",
    "check:typography": "node scripts/check-typography.mjs",
    "check:private": "node scripts/check-private-boundary.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "jsdom": "^26.1.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
